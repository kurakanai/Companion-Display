<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="CompanionDisplayDefaultSlider" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
        <Setter Property="ManipulationMode" Value="All"/>
    </Style>

    <Style x:Key="CompanionDisplaySliderCenter" TargetType="Slider" BasedOn="{StaticResource CompanionDisplayDefaultSlider}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CompanionDisplaySliderSettings" TargetType="Slider" BasedOn="{StaticResource CompanionDisplaySliderCenter}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Width" Value="300"/>
    </Style>

    <Style x:Key="CompanionDisplaySliderMedia" TargetType="Slider" BasedOn="{StaticResource CompanionDisplaySliderCenter}">
        <Setter Property="IsThumbToolTipEnabled" Value="False"/>
    </Style>
</ResourceDictionary>
