<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="CompanionDisplayDefaultGridView" TargetType="GridView">
        <Setter Property="SelectionMode" Value="None"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CompanionDisplayGridViewDraggable" TargetType="GridView" BasedOn="{StaticResource CompanionDisplayDefaultGridView}">
        <Setter Property="CanDragItems" Value="True"/>
        <Setter Property="CanReorderItems" Value="True"/>
        <Setter Property="AllowDrop" Value="True"/>
    </Style>

    <Style x:Key="CompanionDisplayGridViewNonDraggable" TargetType="GridView" BasedOn="{StaticResource CompanionDisplayDefaultGridView}">
        <Setter Property="CanDragItems" Value="False"/>
        <Setter Property="CanReorderItems" Value="False"/>
        <Setter Property="AllowDrop" Value="False"/>
    </Style>

    <Style x:Key="CompanionDisplayGridViewDraggableLaunchpad" TargetType="GridView" BasedOn="{StaticResource CompanionDisplayGridViewDraggable}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0,10,0,0"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>

    <Style x:Key="CompanionDisplayGridViewAdd" TargetType="GridView" BasedOn="{StaticResource CompanionDisplayGridViewNonDraggable}">
        <Setter Property="IsItemClickEnabled" Value="True"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <Style x:Key="CompanionDisplayGridViewMain" TargetType="GridView" BasedOn="{StaticResource CompanionDisplayGridViewDraggable}">
        <Setter Property="Margin" Value="0,45,0,0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="CompanionDisplayGridViewLaunchpad" TargetType="GridView" BasedOn="{StaticResource CompanionDisplayGridViewDraggable}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
</ResourceDictionary>
