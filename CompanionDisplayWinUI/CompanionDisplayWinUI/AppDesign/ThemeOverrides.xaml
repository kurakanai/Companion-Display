<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CompanionDisplayWinUI">
    <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Other merged dictionaries here -->
    </ResourceDictionary.MergedDictionaries>
    <!-- Other app resources here -->
    <AcrylicBrush x:Key="CustomAcrylicInAppLuminosity" TintOpacity="0" FallbackColor="{ThemeResource SystemAltMediumLowColor}" TintColor="{ThemeResource SystemAltLowColor}" />
    <AcrylicBrush x:Key="CustomAcrylicInAppLuminosityAlwaysTransparent" TintOpacity="0" FallbackColor="{ThemeResource SystemAltMediumHighColor}" TintColor="{ThemeResource SystemAltLowColor}" />
    <AcrylicBrush x:Key="CustomAcrylicInAppLuminositySlightTint" TintOpacity="0" FallbackColor="{ThemeResource SystemAltMediumLowColor}" TintColor="{ThemeResource SystemAltLowColor}" />
    <AcrylicBrush x:Key="CustomAcrylicInAppLuminositySlightTintAlwaysTransparent" TintOpacity="0" FallbackColor="{ThemeResource SystemAltMediumHighColor}" TintColor="{ThemeResource SystemAltLowColor}" />
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Display</FontFamily>
</ResourceDictionary>
