<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="CompanionDisplayDefaultToggle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="OffContent" Value=""/>
        <Setter Property="OnContent" Value=""/>
        <Setter Property="IsOn" Value="False"/>
    </Style>
    
    <Style x:Key="CompanionDisplayToggleSettings" TargetType="ToggleSwitch" BasedOn="{StaticResource CompanionDisplayDefaultToggle}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,-110,0"/>
    </Style>
    
</ResourceDictionary>
