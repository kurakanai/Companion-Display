<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CompanionDisplayBaseText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="CompanionDisplayTimeStamp" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayBaseText}">
        <Setter Property="Text" Value="--:--"/>
    </Style>

    <Style x:Key="CompanionDisplayTimeStampCenter" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayTimeStamp}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CompanionDisplayMacroTextBlock" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>
    
    <Style x:Key="CompanionDisplayLogoTextBlock" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayMacroTextBlock}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
        <Setter Property="Text" Value="Companion Display"/>
    </Style>
    
    <Style x:Key="CompanionDisplayBackupTextBlock" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayMacroTextBlock}">
        <Setter Property="FontSize" Value="24"/>
    </Style>
    
    <Style x:Key="CompanionDisplayTitleTextBlock" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Padding" Value="2,0,0,0"/>
    </Style>
    
    <Style x:Key="CompanionDisplayVerticalCenterTextBlock" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <Style x:Key="CompanionDisplayVerticalCenterTextBlockRight" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayVerticalCenterTextBlock}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="CompanionDisplayTextBlockNoItemsLaunchpad" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayMacroTextBlock}">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>
    <!--Icon related-->
    <Style x:Key="CompanionDisplayIconTextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
    </Style>
    <Style x:Key="CompanionDisplayBatteryBase" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayIconTextBase}">
        <Setter Property="Text" Value="&#xe83f;"/>
    </Style>
    <Style x:Key="CompanionDisplayBatterySmall" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayBatteryBase}">
        <Setter Property="Width" Value="25"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style x:Key="CompanionDisplayBatteryWidgetBaseTextBlock" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,-3,0,0"/>
    </Style>
    <Style x:Key="CompanionDisplayBatteryPercentage" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayBatteryWidgetBaseTextBlock}">
        <Setter Property="Text" Value="-%"/>
        <Setter Property="Width" Value="35"/>
    </Style>
    <Style x:Key="CompanionDisplayDevName" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayBatteryWidgetBaseTextBlock}">
        <Setter Property="Text" Value="-"/>
        <Setter Property="Width" Value="160"/>
    </Style>
    <!--Sensors-->
    <Style x:Key="CompanionDisplaySensorLeftBase" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayVerticalCenterTextBlock}">
        <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style x:Key="CompanionDisplaySensorLeftName" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplaySensorLeftBase}">
        <Setter Property="Text" Value="-"/>
        <Setter Property="Foreground" Value="{ThemeResource SystemBaseMediumColor}"/>
    </Style>
    <Style x:Key="CompanionDisplaySensorRightBase" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplaySensorLeftBase}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="CompanionDisplaySensorRight" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplaySensorRightBase}">
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style x:Key="CompanionDisplaySensorRightProgressBar" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplaySensorRightBase}">
        <Setter Property="Margin" Value="0,0,40,0"/>
    </Style>
    <!--Media Stuff-->
    <Style x:Key="CompanionDisplayPlaceholder" TargetType="TextBlock">
        <Setter Property="Text" Value=""/>
    </Style>
    <Style x:Key="CompanionDisplayMediaTitle" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayPlaceholder}">
        <Setter Property="FontSize" Value="40"/>
    </Style>
    <Style x:Key="CompanionDisplayMediaSubtext" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayPlaceholder}">
        <Setter Property="FontSize" Value="25"/>
    </Style>
    <Style x:Key="CompanionDisplayMediaLyrics" TargetType="TextBlock" BasedOn="{StaticResource CompanionDisplayMediaSubtext}">
        <Setter Property="TextWrapping" Value="WrapWholeWords"/>
    </Style>
</ResourceDictionary>
