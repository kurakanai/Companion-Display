<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="CompanionDisplayDefaultExpanderBase" TargetType="Expander">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    
    <Style x:Key="CompanionDisplayDefaultExpander" TargetType="Expander" BasedOn="{StaticResource CompanionDisplayDefaultExpanderBase}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    
    <Style x:Key="CompanionDisplayExpanderColorPicker" TargetType="Expander" BasedOn="{StaticResource CompanionDisplayDefaultExpanderBase}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    
</ResourceDictionary>
