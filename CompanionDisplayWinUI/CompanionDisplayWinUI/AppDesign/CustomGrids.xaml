<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CompanionDisplayGridRadius8" TargetType="Grid">
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="CompanionDisplayMacroGrid" TargetType="Grid" BasedOn="{StaticResource CompanionDisplayGridRadius8}">
        <Setter Property="Height" Value="60"/>
        <Setter Property="Width" Value="60"/>
    </Style>
    
    <Style x:Key="CompanionDisplayBackupGrid" TargetType="Grid">
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <Style x:Key="CompanionDisplayGridTop" TargetType="Grid">
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="CompanionDisplayGridBottom" TargetType="Grid">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <Style x:Key="CompanionDisplayGridRight" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    
    <Style x:Key="CompanionDisplayMediaTimings" TargetType="Grid" BasedOn="{StaticResource CompanionDisplayGridBottom}">
        <Setter Property="Height" Value="36"/>
    </Style>
</ResourceDictionary>
