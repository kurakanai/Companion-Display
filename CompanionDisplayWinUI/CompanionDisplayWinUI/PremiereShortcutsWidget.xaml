<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CompanionDisplayWinUI.PremiereShortcutsWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CompanionDisplayWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Tag="AdobeWidgets"
    Width="500" Height="300">

    <Grid>
        <StackPanel Style="{StaticResource CompanionDisplayStackPanelMiddle}">
            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Content="&#xe7a7;" Grid.Column="1" Name="UndoButton" Tapped="PressKeyCTRL" Tag="90" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button Content="&#xe74e;" Grid.Column="1" Name="SaveButton" Tapped="PressKeyCTRL" Tag="83" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>

            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Content="&#xe768; &#xe769;" Name="PlayPauseBtn" Grid.Column="1" Tag="32" Tapped="PressKeyNoModifiers" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button Content="&#xe8c6; &#xe8b2;" x:Name="SplitButton" Grid.Column="3" Tapped="PressKeyCTRL" Tag="75" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Content="&#xe8b0;" Grid.Column="1" Name="SelectionButton" Tag="86" Tapped="PressKeyNoModifiers" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button Content="&#xe8c6;" x:Name="RazorButton" Grid.Column="3" Tag="67" Tapped="PressKeyNoModifiers" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Content="&#xe71f;" Name="ZoomReduceButton" Grid.Column="1" Tag="109" Tapped="PressKeyCTRL" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button Content="&#xe8a3;" Name="ZoomIncreaseButton" Grid.Column="3" Tag="187" Tapped="PressKeyCTRL" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
