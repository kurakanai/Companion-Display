<common:SharedAdobePage
    x:Class="CompanionDisplayWinUI.ClassImplementations.PhotoshopShortcutsWidget"
    xmlns:common="using:CompanionDisplayWinUI.ClassImplementations"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CompanionDisplayWinUI.ClassImplementations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Tag="AdobeWidgets" Width="500" Height="300" CanDrag="False">

    <Grid>
        <StackPanel Style="{StaticResource CompanionDisplayStackPanelMiddle}">
            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Content="&#xe7a7;" Grid.Column="1" Name="UndoButton" Tapped="PressKeyCTRL" Tag="90" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button Content="&#xee47;" Grid.Column="1" Name="FreeTransformButton" Tapped="PressKeyCTRL" Tag="84" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>

            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Content="&#xe8e6;" Grid.Column="1" Name="DeselectButton" Tag="68" Tapped="PressKeyCTRL" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button Content="&#xe70f;" x:Name="BrushButton" Grid.Column="3" Tapped="PressKeyNoModifiers" Tag="66" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Content="&#xe7c2;" Grid.Column="1" Name="MoveButton" Tag="86" Tapped="PressKeyNoModifiers" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button Content="&#xf571;" x:Name="DuplicateLayerButton" Grid.Column="3" Tag="74" Tapped="PressKeyCTRL" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Content="&#xe71f;" Name="ZoomReduceButton" Grid.Column="1" Tag="109" Tapped="PressKeyCTRL" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button Content="&#xe8a3;" Name="ZoomIncreaseButton" Grid.Column="3" Tag="107" Tapped="PressKeyCTRL" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</common:SharedAdobePage>
