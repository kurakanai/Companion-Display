<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CompanionDisplayWinUI.MediaPlayerWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CompanionDisplayWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Width="500" Height="300" Unloaded="Page_Unloaded" Loaded="Page_Loaded" Tag="ControlWidgets">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>
        <Image Name="AlbumCoverImg" Grid.RowSpan="2" Stretch="UniformToFill" />
        <Rectangle Fill="{ThemeResource CustomAcrylicInAppLuminosity}" Grid.RowSpan="2"/>
        <StackPanel  Margin="10,10,10,0">
            <TextBlock x:Name="SongTitle" Style="{StaticResource CompanionDisplayMediaTitle}"/>
            <TextBlock x:Name="SongInfo" Style="{StaticResource CompanionDisplayMediaSubtext}"/>
            <TextBlock x:Name="AlbumName" Style="{StaticResource CompanionDisplayMediaSubtext}"/>
            <TextBlock x:Name="SongLyrics" Style="{StaticResource CompanionDisplayMediaLyrics}"/>
        </StackPanel>
        <Grid Margin="10,20,10,60" Grid.Row="1" PointerCaptureLost="Grid_PointerCaptureLost" PointerReleased="Grid_PointerCaptureLost" Style="{StaticResource CompanionDisplayGridBottom}">
            <Slider Name="SongProgressBar" Style="{StaticResource CompanionDisplaySliderMedia}" ManipulationStarted="SongProgressBar_ManipulationStarted" ManipulationCompleted="Grid_ManipulationCompleted" Tapped="SongProgressBar_Tapped"/>
        </Grid>
        <Grid Margin="10,0,0,30"  Style="{StaticResource CompanionDisplayMediaTimings}" Grid.Row="1">
            <TextBlock x:Name="CurrentTime" Style="{StaticResource CompanionDisplayTimeStamp}" />
        </Grid>
        <Grid Margin="0,0,10,30" Style="{StaticResource CompanionDisplayMediaTimings}" HorizontalAlignment="Right" Grid.Row="1">
            <TextBlock x:Name="EndTime" Style="{StaticResource CompanionDisplayTimeStamp}"/>
        </Grid>
        <Slider x:Name="VolumeBar" Margin="50,0,50,83" VerticalAlignment="Bottom" Grid.RowSpan="2" ValueChanged="VolumeBar_ValueChanged" ManipulationCompleted="VolumeBar_ManipulationCompleted" ManipulationStarting="VolumeBar_ManipulationStarting" Style="{StaticResource CompanionDisplaySliderMedia}" IsThumbToolTipEnabled="True"/>
        <RepeatButton Content="&#xE993;" Padding="5,0,0,0" Margin="0,0,0,82" Grid.Row="1" Click="HyperlinkButton_Tapped" Style="{StaticResource CompanionDisplayVolumeButtonsBottom}"/>
        <RepeatButton Content="&#xE994;" Margin="0,0,0,82" Padding="2,0,0,0" HorizontalAlignment="Right" Grid.Row="1" Click="HyperlinkButton_Tapped_1" Style="{StaticResource CompanionDisplayVolumeButtonsBottom}"/>
        <Grid Margin="1,34,0,0" Height="89" VerticalAlignment="Top" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <HyperlinkButton Content="&#xf8ad;" Tag="176" Grid.Column="3" Click="PressKey" Style="{StaticResource CompanionDisplayHyperlinkButtonMedia}"/>
            <HyperlinkButton x:Name="PlayPauseBtn" Tag="179" Content="&#xf8ae;" Grid.Column="2" Click="PressKey" Style="{StaticResource CompanionDisplayHyperlinkButtonPlay}"/>
            <HyperlinkButton Content="&#xf8ac;" Tag="177" Grid.Column="1" Click="PressKey" Style="{StaticResource CompanionDisplayHyperlinkButtonMedia}"/>
            <HyperlinkButton Content="&#xe8a7;" x:Name="OpenWindow" FontFamily="Segoe Fluent Icons" Tag="177" Margin="50,0,0,0" Click="HyperlinkButton_Click" Style="{StaticResource CompanionDisplayHyperlinkButtonMediaSmol}"/>
            <HyperlinkButton Content="&#xe708;" x:Name="SleepTimer" FontFamily="Segoe Fluent Icons" Tag="177" Margin="-50,0,0,0" Grid.Column="4" Click="SleepTimer_Click" Style="{StaticResource CompanionDisplayHyperlinkButtonMediaSmol}"/>
        </Grid>
    </Grid>
</Page>
