<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CompanionDisplayWinUI.Pages.Widgets.Adobe.SharedAssets.Shared8ButtonWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CompanionDisplayWinUI.Pages.Widgets.Adobe.SharedAssets"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Name="ButtonHost" Style="{StaticResource CompanionDisplayStackPanelMiddle}">
            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Grid.Column="1" Name="Button1" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button Grid.Column="1" Name="Button2" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Name="Button3" Grid.Column="1" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button x:Name="Button4" Grid.Column="3" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Grid.Column="1" Name="Button5" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button x:Name="Button6" Grid.Column="3" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource CompanionDisplayAdobeStackPanel}">
                <Button Name="Button7" Grid.Column="3" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
                <Button Name="Button8" Grid.Column="1" Style="{StaticResource CompanionDisplayAdobeShortcutButton}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
