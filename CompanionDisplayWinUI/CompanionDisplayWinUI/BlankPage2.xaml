<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CompanionDisplayWinUI.BlankPage2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CompanionDisplayWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded" Loaded="Page_Loaded" IsEnabledChanged="Page_IsEnabledChanged" Background="{ThemeResource SolidBackgroundFillColorTertiary}">

    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" x:Name="ControlsRow"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Margin="5,4,0,0" Content="&#xe76b;" Click="Button_Click" Style="{StaticResource CompanionDisplayBrowserButton}"/>
        <Button Margin="58,4,0,0" Content="&#xe76c;" Click="Button_Click_1" Style="{StaticResource CompanionDisplayBrowserButton}"/>
        <Button Margin="111,4,0,0" Content="&#xe72c;" Click="Button_Click_5" Style="{StaticResource CompanionDisplayBrowserButton}"/>
        <Button Margin="164,4,0,0" Content="&#xe80f;" Click="Button_Click_2" Style="{StaticResource CompanionDisplayBrowserButton}"/>
        <Button Margin="0,4,58,0" Content="&#xe896;" Click="Button_Click_3" Style="{StaticResource CompanionDisplayBrowserButtonRight}"/>
        <Button Margin="0,4,5,0" Content="&#xf738;" Click="Button_Click_4" Style="{StaticResource CompanionDisplayBrowserButtonRight}"/>
        <TextBox Name="AddressBar" Style="{StaticResource CompanionDisplaySearchTextBox}" Margin="217,4,111,0" KeyDown="AddressBar_KeyDown" GotFocus="AddressBar_GotFocus"/>
        <WebView2 x:Name="WebView" Grid.Row="2" NavigationCompleted="WebView_NavigationCompleted" Loaded="WebView_Loaded" CoreWebView2Initialized="WebView_CoreWebView2Initialized"/>
    </Grid>
</Page>
