<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CompanionDisplayWinUI.NORC_WidgetApps"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CompanionDisplayWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="500" Height="300" Loaded="Page_Loaded" Tag="UtilWidgets">

    <Grid>
        <Rectangle Style="{StaticResource CompanionDisplayFillerRectangle}" RightTapped="MainGrid_RightTapped"/>
        <TextBlock Style="{StaticResource CompanionDisplayTextBlockNoItemsLaunchpad}" Name="EmptyApps" x:Uid="EmptyApps"/>
        <Grid Name="MainGrid">
            <GridView Name="BasicGridView" Style="{StaticResource CompanionDisplayGridViewDraggableLaunchpad}"  DragItemsCompleted="BasicGridView_DragItemsCompleted"/>
        </Grid>
    </Grid>
</Page>
